# LM Studio Auto Optimizer - example configuration.
# Copy to .env and adjust. ALL values optional (sane defaults built in).
# See lm_optimizer/config.py for the full reference.

# LM Studio server (Developer API must be enabled in LM Studio)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234

# Model gate: cross-backend loaded-model policy (LM Studio, Ollama, llama.cpp).
# Default 1 = one model at a time, including ours. When every slot is busy the
# job waits and re-checks instead of failing; fallbacks are only tried after
# MODEL_GATE_WAIT_TIMEOUT_S. Set MAX to 2+ on hardware that can hold more.
MODEL_GATE_ENABLED=true
MODEL_GATE_MAX_LOADED_MODELS=1
MODEL_GATE_WAIT_TIMEOUT_S=3600
MODEL_GATE_POLL_INTERVAL_S=180
MODEL_GATE_PROBE_TIMEOUT_S=2
MODEL_GATE_FALLBACK_MODELS=

# Web UI
WEB_UI_HOST=127.0.0.1
WEB_UI_PORT=8080

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
