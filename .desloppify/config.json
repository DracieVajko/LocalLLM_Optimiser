{
  "target_strict_score": 85,
  "review_max_age_days": 30,
  "review_batch_max_files": 80,
  "holistic_max_age_days": 30,
  "generate_scorecard": true,
  "badge_path": "scorecard.png",
  "exclude": [
    "lm_optimizer.egg-info",
    "data/logs",
    "data/reports",
    "data/checkpoints",
    "data/archive",
    "logs",
    "results",
    "__pycache__",
    ".venv",
    "data",
    ".pytest_cache",
    ".ruff_cache",
    ".worktrees",
    ".opencode",
    ".superpowers",
    ".claude",
    ".git",
    ".desloppify",
    "ollama-configs"
  ],
  "ignore": [],
  "ignore_metadata": {},
  "zone_overrides": {
    "hw_monitor.py": "script",
    "lm_optimizer/web_main.py": "script",
    "tools/cleanup.py": "script",
    "tools/full_standard_rest.py": "script",
    "tools/granular_suite.py": "script",
    "tools/live_validation.py": "script",
    "tools/maxctx_probe.py": "script",
    "tools/night_runner.py": "script"
  },
  "review_dimensions": [],
  "large_files_threshold": 0,
  "props_threshold": 0,
  "issue_noise_budget": 10,
  "issue_noise_global_budget": 0,
  "execution_log_max_entries": 10000,
  "needs_rescan": false,
  "languages": {},
  "commit_tracking_enabled": true,
  "commit_pr": 0,
  "commit_default_branch": "",
  "commit_message_template": "desloppify: {status} {count} issue(s) \u2014 {summary}",
  "trust_plugins": false,
  "transition_messages": {},
  "hermes_enabled": false,
  "hermes_models": {
    "execute": "openrouter:x-ai/grok-4.20-beta",
    "review": "openrouter:google/gemini-3.1-pro-preview"
  }
}
