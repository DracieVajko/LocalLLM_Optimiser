# Virtualenvs
.venv/
venv/
.env

# Python caches / build artifacts
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/

# Test / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local runtime state (machine-specific, never part of a release)
data/*.db
data/logs/
data/reports/
data/presets/
data/checkpoints/
logs/
results/
*.log

# Local model comparison reports (machine-specific; frontier results live in docs/benchmarks)
comparison.md
comparison.csv

# Pause signal flags (live control files)
pause_*.flag

# Temporary / backup / merge artifacts (never commit; do NOT broaden to .env.*)
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*.swo
*~

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Linked git worktrees (local checkouts, never commit)
.worktrees/

# Superpowers local working ledgers
.superpowers/

# Desloppify health-scan state (local analysis, plans and review packets).
# The scan history stays on this machine; it is never part of a release.
.desloppify/

# Exported LM Studio preset files (generated, machine-specific)
lmstudio-presets/

# Runtime data (DB, logs, reports, checkpoints)
data/
